{
  "name": "APK Downloader for Minecraft: Kindle Fire Edition",
  "description": "Downloads Minecraft for Kindle Fire from an Amazon account that owns the app.",
  "version": "1.0",
  "author": "Alec Breen",
  "manifest_version": 3,
  "icons": {
    "16": "img/icon-16.png",
    "48": "img/icon-48.png",
    "128": "img/icon-128.png"
  },
  "background": {
    "service_worker": "js/background-service-worker.js"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "Open APK Downloader Options",
    "default_icon": {
      "16": "img/icon-16.png",
      "48": "img/icon-48.png",
      "128": "img/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.amazon.com/*",
        "*://*.amazon.com.au/*",
        "*://*.amazon.com.br/*",
        "*://*.amazon.com.ca/*",
        "*://*.amazon.com.cn/*",
        "*://*.amazon.com.fr/*",
        "*://*.amazon.com.de/*",
        "*://*.amazon.com.in/*",
        "*://*.amazon.com.it/*",
        "*://*.amazon.com.nl/*",
        "*://*.amazon.com.es/*",
        "*://*.amazon.com.co.jp/*",
        "*://*.amazon.com.com.mx/*",
        "*://*.amazon.co.uk/*"
      ],
      "run_at": "document_end",
      "js": [
        "js/browser-support.js",
        "js/cs/content-scripts.js"
      ]
    },
    {
      "matches": [
        "*://*.amazon.com/gp/yourstore/home*",
        "*://*.amazon.com.au/gp/yourstore/home*",
        "*://*.amazon.com.br/gp/yourstore/home*",
        "*://*.amazon.com.ca/gp/yourstore/home*",
        "*://*.amazon.com.cn/gp/yourstore/home*",
        "*://*.amazon.com.fr/gp/yourstore/home*",
        "*://*.amazon.com.de/gp/yourstore/home*",
        "*://*.amazon.com.in/gp/yourstore/home*",
        "*://*.amazon.com.it/gp/yourstore/home*",
        "*://*.amazon.com.nl/gp/yourstore/home*",
        "*://*.amazon.com.es/gp/yourstore/home*",
        "*://*.amazon.com.co.jp/gp/yourstore/home*",
        "*://*.amazon.com.com.mx/gp/yourstore/home*",
        "*://*.amazon.co.uk/gp/yourstore/home*"
      ],
      "run_at": "document_start",
      "js": [
        "js/browser-support.js",
        "js/cs/oauth2.js"
      ]
    }
  ],
  "permissions": [
    "storage",
    "downloads",
    "declarativeNetRequestWithHostAccess",
    "offscreen",
    "cookies"
  ],
  "host_permissions": [
    "https://api.amazon.com/*",
    "https://mas-ext.amazon.com/*",
    "https://www.amazon.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "img/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "key": "",
  "version_name": "v1.0"
}
